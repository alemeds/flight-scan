# Archivo de ejemplo para configuración de Streamlit
# Copia este archivo a .streamlit/secrets.toml y completa con tus credenciales

# =============================================================================
# API DE VUELOS — Sky Scrapper (RapidAPI)
# =============================================================================
# Suscribirse en https://rapidapi.com/apiheya/api/sky-scrapper y copiar la key

RAPIDAPI_KEY = "your_rapidapi_key"

# =============================================================================
# BASE DE DATOS — Google Sheets
# =============================================================================
# Planilla usada como base de datos. Debe existir en Google Sheets y estar
# compartida (rol Editor) con el client_email de la service account.
# SHEET_ID (el ID de la URL de la planilla) tiene prioridad sobre SHEET_NAME.

SHEET_NAME = "flight-scan-db"
# SHEET_ID = "1AbC...xyz"

# Credenciales de la Google Service Account (crear en Google Cloud Console:
# proyecto -> IAM -> Service Accounts -> Keys -> JSON, y pegar los campos aca)
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
client_id = "your-client-id"
token_uri = "https://oauth2.googleapis.com/token"

# =============================================================================
# DESARROLLO LOCAL / MONITOR POR CRON (variables de entorno, no este archivo)
# =============================================================================
# monitor_script.py y el desarrollo sin Streamlit leen del entorno:
#
# RAPIDAPI_KEY             = misma key de arriba
# GCP_SERVICE_ACCOUNT_FILE = path al JSON de la service account (NO commitear,
#                            está cubierto por .gitignore)
# SHEET_NAME / SHEET_ID    = idem arriba

# =============================================================================
# NOTIFICACIONES POR EMAIL (solo monitor_script.py)
# =============================================================================
# El script de monitoreo NO lee este archivo: toma estas variables del entorno
# (cron local o GitHub Actions secrets). Sin ellas, las alertas se detectan
# pero no se envía email.
#
# SMTP_HOST       = "smtp.gmail.com"
# SMTP_PORT       = 587 (default)
# SMTP_USER       = "your_email@gmail.com"
# SMTP_PASSWORD   = "your_app_password"  (en Gmail: App Password, no la clave normal)
# ALERT_EMAIL_TO  = destinatario (default: SMTP_USER)

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. NO SUBAS ESTE ARCHIVO AL REPOSITORIO
#    Ya está incluido en .gitignore
#
# 2. Para Streamlit Cloud:
#    - Ve a tu app en https://share.streamlit.io
#    - Settings → Secrets
#    - Copia y pega el contenido de este archivo (con valores reales)
#
# 3. Para uso local:
#    - Crea la carpeta .streamlit/ en la raíz del proyecto
#    - Copia este archivo como .streamlit/secrets.toml
#    - Actualiza con tus credenciales reales
#
# 4. Para GitHub Actions (monitor):
#    - Ve a Settings → Secrets and variables → Actions
#    - Agrega cada variable como un secreto separado
#
# =============================================================================
